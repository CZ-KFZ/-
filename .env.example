# ============================================================
# EchoVerse · 飞书环境变量
# ------------------------------------------------------------
# 使用说明：
#   1) 本地开发：复制本文件为 .env 并填入密钥（.env 已在 .gitignore 中，不会泄露）
#   2) 线上部署：在 Vercel 项目设置 > Settings > Environment Variables 中按同名添加
#   3) 未配置或留空时，网站会自动回退到内置 mock 数据，仍可正常访问
#   4) 只有 FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_APP_TOKEN 是必须的，
#      各张数据表的 table_id 可选——哪张表没配，对应页面就回退到 mock 数据
# ============================================================

# ---- 必填：飞书自建应用凭证 ----
# 在「飞书开放平台」> 你的应用 > 凭证与基础信息 里找到
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 必填：多维表格 app_token ----
# 打开你的飞书多维表格，看浏览器地址栏：
#   https://xxx.feishu.cn/base/XXXXXXXXXXXXXX  ← /base/ 后面那串就是 app_token
FEISHU_APP_TOKEN=IELSbNquXacH8SsZmCxc1b4JngC

# ---- 可选：各数据表的 table_id ----
# 在多维表格里打开对应的数据表，地址栏 ?table=tttXXXXXXXX 后面那串就是 table_id
# 不配则对应页面走 mock 数据

# 文章表（articles 页面）
FEISHU_TABLE_ARTICLES=

# 作品集表（portfolio 页面）
FEISHU_TABLE_PROJECTS=

# 数字花园笔记表（garden 页面）
FEISHU_TABLE_NOTES=

# 成长轨迹时间线表（about 页面）
FEISHU_TABLE_TIMELINE=

# 站点设置表（about 页面：姓名/头像/简介等）
FEISHU_TABLE_SETTINGS=

# 订阅者表（首页邮箱订阅：访客邮箱自动写入此表）
FEISHU_TABLE_SUBSCRIBERS=tbljk6yJ4xNwzAYI

# 互助申请表（关于页「给她的一小束光」：卫生巾/吃饭补助申请记录）
# 字段约定：申请类型（下拉：卫生巾/吃饭）/ 微信号 / 手机号 / 收件地址 / 收款码 / 困难简述 / 设备指纹 / 状态（下拉：待审/通过/拒绝/已发放/黑名单）/ 申请时间 / 审核备注
FEISHU_TABLE_AID=tblnbXgbdUGG7d8T

# 互助申请表单 share_token（混合方案：用飞书 form-submit API 写入）
# 从表单分享链接提取：https://xxx.feishu.cn/share/base/shrcnXXXX 里的 shrcnXXXX
FEISHU_FORM_AID=shrcnk3oup6JiOF8eltCJvdoa8r
