# ============================================================
# EchoVerse · 飞书环境变量
# ------------------------------------------------------------
# 使用说明：
#   1) 本地开发：复制本文件为 .env 并填入密钥（.env 已在 .gitignore 中，不会泄露）
#   2) 线上部署：在 Vercel 项目设置 > Settings > Environment Variables 中按同名添加
#   3) 未配置或留空时，网站会自动回退到内置 mock 数据，仍可正常访问
#   4) 只有 FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_APP_TOKEN 是必须的，
#      各张数据表的 table_id 可选——哪张表没配，对应页面就回退到 mock 数据
# ============================================================

# ---- 必填：飞书自建应用凭证 ----
# 在「飞书开放平台」> 你的应用 > 凭证与基础信息 里找到
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 必填：多维表格 app_token ----
# 打开你的飞书多维表格，看浏览器地址栏：
#   https://xxx.feishu.cn/base/XXXXXXXXXXXXXX  ← /base/ 后面那串就是 app_token
FEISHU_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：各数据表的 table_id ----
# 在多维表格里打开对应的数据表，地址栏 ?table=tttXXXXXXXX 后面那串就是 table_id
# 不配则对应页面走 mock 数据

# 文章表（articles 页面）
FEISHU_TABLE_ARTICLES=

# 作品集表（portfolio 页面）
FEISHU_TABLE_PROJECTS=

# 数字花园笔记表（garden 页面）
FEISHU_TABLE_NOTES=

# 成长轨迹时间线表（about 页面）
FEISHU_TABLE_TIMELINE=

# 站点设置表（about 页面：姓名/头像/简介等）
FEISHU_TABLE_SETTINGS=
